{
  "name": "panime-stream-proxy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape:episodes": "node scripts/scrape_and_inject_toonstream.js",
    "scrape:new": "node scripts/scrape_and_inject_toonstream.js",
    "scrape:toonstream": "node scripts/scrape_and_inject_toonstream.js",
    "scrape:salt": "node scripts/scrape_animesalt_master.js",
    "scrape:salt:master": "node scripts/scrape_animesalt_master.js",
    "scrape:salt:discover": "node scripts/scrape_animesalt_master.js --discover",
    "scrape:salt:merge": "node scripts/scrape_animesalt_master.js --merge-only",
    "scrape": "node scripts/scrape_and_inject_toonstream.js",
    "sync:auto": "node scripts/scrape_and_inject_toonstream.js",
    "catalog:refresh": "node scripts/refresh_toonstream_catalog.js",
    "streams:patch": "node scripts/patch_all_toonstream_streams.js",
    "streams:patch-movies": "node scripts/patch_all_toonstream_streams.js --movies",
    "streams:patch-series": "node scripts/patch_all_toonstream_streams.js --series",
    "scrape:haz": "node scripts/scrape_haz_master.js",
    "fetch:haz": "node scripts/scrape_haz_master.js",
    "streams:haz": "node scripts/resolve_all_haz_streams.js",
    "fetch:all": "node scripts/scrape_haz_master.js && node scripts/resolve_all_haz_streams.js && node scripts/scrape_animesalt_master.js && node scripts/scrape_all_salt_streams.js",
    "streams:ensure-all": "node scripts/scrape_all_salt_streams.js",
    "streams:salt-movies": "node scripts/scrape_all_salt_streams.js --movies",
    "streams:salt-series": "node scripts/scrape_all_salt_streams.js --series",
    "streams:full-refresh": "node scripts/refresh_toonstream_catalog.js && node scripts/patch_all_toonstream_streams.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cheerio": "^1.2.0",
    "hls.js": "^1.7.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "typescript": "^5"
  }
}
